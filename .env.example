# =====================================================
# TZ Connect Wi-Fi Platform — Environment Variables
# =====================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file.

# --- Application ---
NODE_ENV=development
APP_NAME=TZ Connect Wi-Fi
APP_URL=http://localhost:3000
APP_PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tzconnect:tzconnect@localhost:5432/tzconnect?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Session / Auth ---
AUTH_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-jwt-secret
SESSION_TTL_SECONDS=604800

# --- Seed admin credentials (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL=admin@tzconnect.co.tz
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ORG_NAME=TZ Connect
SEED_SITE_NAME=TZ Connect Demo Site

# --- MikroTik RouterOS API ---
# Comma-separated list of routers, or individual router configuration.
MIKROTIK_HOST=10.0.0.1
MIKROTIK_API_PORT=8728
MIKROTIK_API_SECURE_PORT=8729
MIKROTIK_USERNAME=tzconnect
MIKROTIK_PASSWORD=replace-me
MIKROTIK_TLS_ENABLED=false
MIKROTIK_HOTSPOT_SERVER=hotspot1
MIKROTIK_DEFAULT_PROFILE=default

# --- Mobile Money / Payment Providers ---
# M-Pesa
MPESA_ENABLED=false
MPESA_API_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://api.tzconnect.co.tz/api/payments/webhooks/mpesa

# Airtel Money
AIRTEL_ENABLED=false
AIRTEL_API_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=TZ
AIRTEL_CURRENCY=TZS
AIRTEL_CALLBACK_URL=https://api.tzconnect.co.tz/api/payments/webhooks/airtel

# Mixx by Yas
MIXX_ENABLED=false
MIXX_API_URL=
MIXX_CLIENT_ID=
MIXX_CLIENT_SECRET=

# HaloPesa
HALOPESA_ENABLED=false
HALOPESA_API_URL=
HALOPESA_API_KEY=

# Generic payment webhook secret (shared HMAC secret for testing/mocks)
PAYMENT_WEBHOOK_SECRET=

# --- SMS ---
SMS_PROVIDER=mock
# Africa's Talking SMS
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp ---
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_NUMBER=

# --- Monitoring ---
MONITORING_SCAN_INTERVAL_MS=30000
ALERT_CPU_THRESHOLD_PERCENT=90
ALERT_MEMORY_THRESHOLD_PERCENT=90
ALERT_BANDWIDTH_THRESHOLD_MBPS=900

# --- Observability ---
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id

# --- Background Jobs ---
JOBS_QUEUE_HOST=localhost
JOBS_QUEUE_PORT=6379

# --- Voucher ---
VOUCHER_LENGTH=10
VOUCHER_ALPHABET=ABCDEFGHJKMNPQRSTUVWXYZ23456789

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
